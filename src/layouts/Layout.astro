---
interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = 'Blog técnico especializado en Docker, Linux SysAdmin y despliegues de Odoo ERP.', image = '/og-image.png' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Synergia Tech Blog</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
  </head>
  <body>
    <div class="syn-glow-cyan"></div>
    <div class="syn-glow-purple"></div>

    <header class="syn-nav">
      <div class="syn-container syn-nav-inner">
        <a href="/" class="syn-brand">
          <span class="syn-brand-dot"></span>
          <span class="syn-brand-text">SYNERGIA</span>
          <span class="syn-badge">TECH BLOG</span>
        </a>
        <nav class="syn-links">
          <a href="https://synergia.website" target="_blank">Web Principal ➔</a>
          <a href="https://synergia.website/formulario-de-contacto/" target="_blank" class="syn-btn-nav">Contacto IT</a>
        </nav>
      </div>
    </header>

    <main class="syn-container">
      <slot />
    </main>

    <footer class="syn-footer">
      <div class="syn-container syn-footer-inner">
        <p>&copy; {new Date().getFullYear()} Synergia. Servidores Dedicados, Docker &amp; Partner Odoo ERP.</p>
        <p class="syn-footer-sub">Alojado con arquitectura estática en GitHub Pages &amp; Cloudflare Edge.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg-dark: #07090e;
    --card-bg: rgba(15, 23, 42, 0.65);
    --border-color: rgba(255, 255, 255, 0.08);
    --text-main: #e2e8f0;
    --text-muted: #94a3b8;
    --cyan: #00f2fe;
    --purple: #a855f7;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background-color: var(--bg-dark);
    color: var(--text-main);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    line-height: 1.6;
    overflow-x: hidden;
    position: relative;
    min-height: 100vh;
  }

  .syn-container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Glows */
  .syn-glow-cyan {
    position: absolute;
    top: 0;
    left: 10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(0, 242, 254, 0.12) 0%, transparent 70%);
    filter: blur(100px);
    pointer-events: none;
    z-index: 0;
  }
  .syn-glow-purple {
    position: absolute;
    top: 250px;
    right: 5%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(168, 85, 247, 0.12) 0%, transparent 70%);
    filter: blur(100px);
    pointer-events: none;
    z-index: 0;
  }

  /* Header */
  .syn-nav {
    border-bottom: 1px solid var(--border-color);
    backdrop-filter: blur(16px);
    background: rgba(7, 9, 14, 0.85);
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 16px 0;
  }
  .syn-nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .syn-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: #fff;
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: 0.05em;
  }
  .syn-brand-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 10px var(--cyan);
  }
  .syn-badge {
    background: rgba(0, 242, 254, 0.12);
    border: 1px solid rgba(0, 242, 254, 0.3);
    color: var(--cyan);
    font-size: 0.7rem;
    padding: 2px 8px;
    border-radius: 20px;
  }
  .syn-links {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .syn-links a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s;
  }
  .syn-links a:hover { color: var(--cyan); }
  .syn-btn-nav {
    background: linear-gradient(135deg, rgba(0, 242, 254, 0.15), rgba(168, 85, 247, 0.15)) !important;
    border: 1px solid rgba(0, 242, 254, 0.4) !important;
    color: #fff !important;
    padding: 6px 14px;
    border-radius: 6px;
    font-weight: 600;
  }

  /* Footer */
  .syn-footer {
    border-top: 1px solid var(--border-color);
    margin-top: 80px;
    padding: 40px 0;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .syn-footer-sub {
    font-size: 0.8rem;
    margin-top: 6px;
    color: #64748b;
  }

  /* Markdown styles */
  .prose {
    line-height: 1.8;
    color: #cbd5e1;
    font-size: 1.1rem;
  }
  .prose h2 {
    color: #fff;
    margin: 40px 0 16px;
    font-size: 1.8rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 8px;
  }
  .prose h3 {
    color: #fff;
    margin: 30px 0 12px;
    font-size: 1.4rem;
  }
  .prose p { margin-bottom: 20px; }
  .prose ul, .prose ol { margin: 0 0 20px 24px; }
  .prose li { margin-bottom: 8px; }
  .prose a { color: var(--cyan); text-decoration: none; }
  .prose a:hover { text-decoration: underline; }
  .prose code:not(pre code) {
    background: rgba(255, 255, 255, 0.08);
    color: var(--cyan);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.9em;
  }
  .prose pre {
    background: #0d1117 !important;
    border: 1px solid var(--border-color);
    padding: 18px;
    border-radius: 8px;
    margin: 20px 0;
    overflow-x: auto;
  }
</style>
