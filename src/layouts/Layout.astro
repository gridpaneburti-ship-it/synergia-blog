---
interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
}

const { 
  title, 
  description = 'Blog de ingeniería de Synergia. Guías técnicas sobre arquitectura de servidores Linux, contenedores Docker y despliegues de Odoo ERP en producción.',
  ogType = 'website'
} = Astro.props;

// Ensure canonical URL always ends with a slash to match directory output (prevents 301 redirects)
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalURL = new URL(pathname, Astro.site);

// Format page title to stay within 60 characters for SEO
const displayTitle = title.length > 45 
  ? title 
  : `${title} | Synergia`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{displayTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={displayTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Synergia Engineering Blog" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:image" content="https://synergia.website/wp-content/uploads/2024/05/cropped-favicon-192x192.png" />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={displayTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://synergia.website/wp-content/uploads/2024/05/cropped-favicon-192x192.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <!-- Privacy-friendly analytics by Plausible -->
    <script async src="https://plausible.burtiraven4.synology.me/js/pa-orzfY06vp4LAp6j_w-rvP.js" is:inline></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand">
          <span class="brand-name">synergia</span><span class="brand-suffix">/engineering</span>
        </a>
        <nav class="nav-links">
          <a href="/">Artículos</a>
          <a href="https://synergia.website" target="_blank" rel="noopener">Web Principal ↗</a>
        </nav>
      </div>
    </header>

    <main class="content-wrapper">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <p>Publicación técnica independiente de Synergia. Escrito por ingenieros.</p>
        <div class="footer-links">
          <span>&copy; {new Date().getFullYear()}</span>
          <span>•</span>
          <a href="/">Inicio</a>
          <span>•</span>
          <a href="https://synergia.website" target="_blank" rel="noopener">Synergia</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0f1117;
    --bg-subtle: #161a22;
    --border: #21262d;
    --text: #e6edf3;
    --text-muted: #8b949e;
    --text-dim: #6e7681;
    --accent: #58a6ff;
    --accent-hover: #79b8ff;
    --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-serif: 'Newsreader', Georgia, serif;
    --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background-color: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  a { color: inherit; text-decoration: none; transition: color 0.15s ease; }

  .site-header {
    border-bottom: 1px solid var(--border);
    padding: 22px 0;
  }
  .header-inner {
    max-width: 740px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .brand {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .brand-name { color: #fff; }
  .brand-suffix { color: var(--text-muted); font-weight: 400; }

  .nav-links {
    display: flex;
    gap: 20px;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .nav-links a:hover { color: var(--accent); }

  .content-wrapper {
    max-width: 740px;
    width: 100%;
    margin: 0 auto;
    padding: 48px 24px 80px;
    flex: 1;
  }

  .site-footer {
    border-top: 1px solid var(--border);
    padding: 36px 0;
    font-size: 0.85rem;
    color: var(--text-dim);
  }
  .footer-inner {
    max-width: 740px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }
  .footer-links { display: flex; gap: 10px; }
  .footer-links a:hover { color: var(--accent); }

  /* Body prose for true blog reading experience */
  .prose {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.85;
    color: #d1d7e0;
  }
  .prose p { margin-bottom: 1.6em; }
  .prose h2 {
    font-family: var(--font-sans);
    color: #fff;
    font-size: 1.55rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-top: 2.2em;
    margin-bottom: 0.8em;
  }
  .prose h3 {
    font-family: var(--font-sans);
    color: #f0f6fc;
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 1.8em;
    margin-bottom: 0.6em;
  }
  .prose ul, .prose ol { margin: 0 0 1.6em 1.5em; }
  .prose li { margin-bottom: 0.5em; }
  .prose a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .prose a:hover { color: var(--accent-hover); }
  .prose blockquote {
    border-left: 3px solid var(--accent);
    padding-left: 20px;
    margin: 2em 0;
    color: var(--text-muted);
    font-style: italic;
  }
  .prose code:not(pre code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: rgba(110, 118, 129, 0.2);
    color: #f0883e;
    padding: 0.2em 0.4em;
    border-radius: 4px;
  }
  .prose pre {
    background: #0d1117 !important;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px 20px;
    margin: 2em 0;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.6;
  }
</style>
