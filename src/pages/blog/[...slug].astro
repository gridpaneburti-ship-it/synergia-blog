---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

const post = Astro.props;
const { Content } = await post.render();
---

<Layout title={post.data.title} description={post.data.description}>
  <article class="article-wrapper">
    <div class="article-header">
      <a href="/" class="back-link">← Volver al blog</a>
      <div class="article-meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        <span>•</span>
        <span>Autor: {post.data.author}</span>
      </div>
      <h1 class="article-title">{post.data.title}</h1>
      <p class="article-lead">{post.data.description}</p>
      <div class="tag-list">
        {post.data.tags.map((t) => (
          <span class="tag">#{t}</span>
        ))}
      </div>
    </div>

    <div class="article-content prose">
      <Content />
    </div>

    <!-- CTA Box -->
    <div class="cta-banner">
      <h3>¿Necesitas soporte técnico para tus servidores o contenedores Docker?</h3>
      <p>En Synergia administramos infraestructura crítica, afinamos bases de datos PostgreSQL y desplegamos Odoo ERP de alto rendimiento.</p>
      <a href="https://synergia.website/formulario-de-contacto/" target="_blank" class="btn-cta">
        Solicitar Consulta Técnica ➔
      </a>
    </div>
  </article>
</Layout>

<style>
  .article-wrapper {
    max-width: 820px;
    margin: 40px auto 80px;
  }
  .back-link {
    color: var(--cyan);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    display: inline-block;
    margin-bottom: 20px;
  }
  .article-meta {
    display: flex;
    gap: 10px;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 12px;
  }
  .article-title {
    font-size: clamp(2rem, 4vw, 2.8rem);
    color: #fff;
    line-height: 1.2;
    margin-bottom: 16px;
    font-weight: 800;
  }
  .article-lead {
    font-size: 1.2rem;
    color: #cbd5e1;
    margin-bottom: 20px;
    line-height: 1.6;
  }
  .tag-list {
    display: flex;
    gap: 8px;
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border-color);
  }
  .tag {
    background: rgba(255, 255, 255, 0.05);
    color: var(--cyan);
    font-size: 0.8rem;
    padding: 3px 10px;
    border-radius: 4px;
  }
  .article-content {
    margin-top: 30px;
  }
  .cta-banner {
    margin-top: 60px;
    background: linear-gradient(145deg, rgba(0, 242, 254, 0.08), rgba(168, 85, 247, 0.08));
    border: 1px solid rgba(0, 242, 254, 0.3);
    border-radius: 12px;
    padding: 32px;
    text-align: center;
  }
  .cta-banner h3 {
    color: #fff;
    font-size: 1.35rem;
    margin-bottom: 12px;
  }
  .cta-banner p {
    color: var(--text-muted);
    font-size: 1rem;
    margin-bottom: 24px;
    max-width: 580px;
    margin-left: auto;
    margin-right: auto;
  }
  .btn-cta {
    display: inline-block;
    background: linear-gradient(135deg, var(--cyan), #00b4d8);
    color: #07090e;
    font-weight: 700;
    padding: 12px 28px;
    border-radius: 6px;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .btn-cta:hover { opacity: 0.9; }
</style>
