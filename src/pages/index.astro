---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Artículos y Notas Técnicas">
  <div class="feed-header">
    <h1 class="feed-title">Artículos</h1>
    <p class="feed-intro">
      Notas de ingeniería, arquitectura de sistemas, Linux y contenedores en producción.
    </p>
  </div>

  <div class="posts-feed">
    {posts.map((post) => (
      <article class="feed-item">
        <div class="item-meta">
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' })}
          </time>
          {post.data.tags && post.data.tags.length > 0 && (
            <span class="item-tag">{post.data.tags[0]}</span>
          )}
        </div>

        <h2 class="item-title">
          <a href={`/blog/${post.slug}`}>{post.data.title}</a>
        </h2>

        <p class="item-excerpt">{post.data.description}</p>
      </article>
    ))}
  </div>
</Layout>

<style>
  .feed-header {
    margin-bottom: 50px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }
  .feed-title {
    font-size: 2.2rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.025em;
    margin-bottom: 8px;
  }
  .feed-intro {
    font-size: 1.05rem;
    color: var(--text-muted);
  }
  .posts-feed {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .feed-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .item-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.85rem;
    color: var(--text-dim);
    font-variant-numeric: tabular-nums;
  }
  .item-tag {
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.75rem;
    padding: 1px 8px;
    border-radius: 12px;
    text-transform: lowercase;
  }
  .item-title {
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.015em;
  }
  .item-title a { color: #fff; }
  .item-title a:hover { color: var(--accent); }
  .item-excerpt {
    font-size: 0.98rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
</style>
